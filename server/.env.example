# ---- RehoCheck API configuration -------------------------------------------
# Copy to .env and fill in. Never commit .env — it holds live secrets.

# Port the API listens on (Render sets this automatically).
PORT=3000

# --- Provider keys (server-side only, never sent to the browser) ------------

# Google Safe Browsing v4 — https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_KEY=

# VirusTotal v3 — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Model used for /api/verify-news
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Behaviour --------------------------------------------------------------

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=*

# Requests allowed per device per window (protects your provider quota).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=300000

# Set to 0 to serve the API only (no static front-end).
SERVE_STATIC=1

# Set to 1 to log one line per request (never logs bodies).
LOG_REQUESTS=0
